    <!-- Scenarios -->
    <string name="scn_conquest_1943">1943 · 转折点</string>
    <string name="scn_conquest_1943_desc">1943 年 3 月。轴心国的版图到了顶点，从大西洋岸到顿涅茨、从满洲到南洋，而斯大林格勒刚刚回到苏联手上。该参战的都已经参战。选一边，看战局会不会就此逆转。</string>
    <string name="scn_conquest_1950">1950 · 两大阵营</string>
    <string name="scn_conquest_1950_desc">1950 年 1 月。德国与朝鲜一分为二，中华人民共和国成立才三个月，非洲大半仍是殖民地。西方与东方隔着一条穿过柏林的线对峙，其他国家宁可不选边。</string>
    <string name="scn_conquest_1980">1980 · 北约与华约</string>
    <string name="scn_conquest_1980_desc">1980 年 1 月。帝国都已经散了，世界大半属于自己。北约与华约在欧洲对峙，中国、印度与不结盟国家站在两者之外。</string>
    <string name="scn_conquest_1939">1939 · 全球</string>
    <string name="scn_conquest_1939_desc">帝国手中的世界：非洲与南亚不属于自己，属于伦敦、巴黎与罗马。轴心与同盟已经开战，苏联与美国要再过几个回合才会加入。想选谁都行。</string>
    <string name="scn_campaign_ww2_01_poland_axis">1939 · 白色方案</string>
    <string name="scn_campaign_ww2_01_poland_axis_desc">装甲、飞机、兵力，你样样都有，唯独没有时间：在回合用完之前拿下华沙与克拉科夫，别让挖好壕沟的守军把时间拖回去。</string>
    <string name="scn_campaign_ww2_02_france_allies">1940 · 守住巴黎</string>
    <string name="scn_campaign_ww2_02_france_allies_desc">防线摆错了地方，装甲正从缺口涌进来。这一仗你不必赢，只要第 20 回合巴黎还在法国手上。</string>
    <string name="scn_campaign_ww2_03_desert_axis">1942 · 通往亚历山大港</string>
    <string name="scn_campaign_ww2_03_desert_axis_desc">你的坦克比较好，补给线也比较长。往尼罗河多走一格，就离突尼斯远一格。在沙漠替敌人把仗打完之前，拿下亚历山大港与开罗。</string>
    <string name="scn_campaign_ww2_05_east_front_axis">1943 · 守住聂伯河</string>
    <string name="scn_campaign_ww2_05_east_front_axis_desc">主动权已经没了，也不会再回来。面对样样都比你多的对手，把基辅与哈尔科夫守到第 28 回合，而且守的时候别让自己被包围。</string>
    <string name="scn_campaign_ww2_04_south_seas_allies">1942 · 新加坡要塞</string>
    <string name="scn_campaign_ww2_04_south_seas_allies_desc">新加坡的炮口朝着海，敌人却从丛林里来。守到第 22 回合。舰队救不了你，别把它耗在这上面。</string>
    <string name="scn_campaign_ww2_06_philippines">1944 · 重返菲律宾</string>
    <string name="scn_campaign_ww2_06_philippines_desc">不必把每一座岛都拿下。拿下切断敌人航线的那几座，其余的会自己饿死。目标是马尼拉与塞布。</string>
    <string name="scn_campaign_ww2_06_philippines_axis">1944 · 最后防线</string>
    <string name="scn_campaign_ww2_06_philippines_axis_desc">打赢这片海洋的舰队已经没了。用剩下的东西把马尼拉与塞布守到第 26 回合，让每一次登陆都比上一次更贵。</string>
    <string name="scn_campaign_cw_01_suez_west">1956 · 火枪手行动</string>
    <string name="scn_campaign_cw_01_suez_west_desc">先空降，再登陆。在全世界决定这场仗不该打之前，拿下亚历山大港与开罗。</string>
    <string name="scn_campaign_cw_02_indochina_west">1968 · 守住西贡</string>
    <string name="scn_campaign_cw_02_indochina_west_desc">天空与海洋都是你的，但它们都守不住土地。对手只要还在就算赢。把西贡守到第 30 回合。</string>
    <string name="scn_campaign_cw_03_central_front_pact">1985 · 穿越富尔达缺口</string>
    <string name="scn_campaign_cw_03_central_front_pact_desc">计划就是速度：在增援横渡大西洋之前冲到莱茵河。拿下汉堡与慕尼黑，不在路上的东西都别停下来打。</string>
    <string name="scn_campaign_ww2_01_poland">1939 · 波兰</string>
    <string name="scn_campaign_ww2_01_poland_desc">装甲、飞机、人数，你样样都少。这一关赢不了，但可以让对方付出代价：守住华沙到第 20 回合。</string>
    <string name="scn_campaign_ww2_02_france">1940 · 法兰西</string>
    <string name="scn_campaign_ww2_02_france_desc">装甲不是用来磨穿战线的，是用来灌进缺口的。撕开正面，然后别停 —— 突击部队打掉目标之后还能再打一次。</string>
    <string name="scn_campaign_ww2_03_desert">1942 · 西部沙漠</string>
    <string name="scn_campaign_ww2_03_desert_desc">这里没有掩蔽，也没有补给。单位对单位你打不赢非洲军，但到的黎波里的距离会替你打赢。</string>
    <string name="scn_campaign_ww2_04_south_seas">1942 · 南洋</string>
    <string name="scn_campaign_ww2_04_south_seas_desc">这里没有一个目标走得到。航舰买下天空，运输舰载着步兵，两者缺一的登陆叫溺水。</string>
    <string name="scn_campaign_ww2_05_east_front">1943 · 东线</string>
    <string name="scn_campaign_ww2_05_east_front_desc">现在数量在你这边，好坦克还在对面。不要对等交换 —— 包围。四面受敌的部队会崩溃。</string>
    <string name="scn_campaign_cw_01_suez">1956 · 苏伊士</string>
    <string name="scn_campaign_cw_01_suez_desc">登陆从天上先来，海上后到。你的坦克对伞兵没用，你的防空有用。</string>
    <string name="scn_campaign_cw_02_indochina">1968 · 印度支那</string>
    <string name="scn_campaign_cw_02_indochina_desc">对面每一项数据都比你大，而那些东西都得飞进来。让天空变贵，丛林会处理剩下的。</string>
    <string name="scn_campaign_cw_03_central_front">1985 · 中欧正面</string>
    <string name="scn_campaign_cw_03_central_front_desc">六面盟旗，但你只指挥得动一支军队。其他人替你换回合 —— 那是拿来花的，不是拿来存的。守住三座城到第 30 回合。</string>

